# Run with cmake -P by ops_add_jit_artifacts: -DDIR=<dir with <k>.json/<k>.mlirbc> -DKERNELS=<k;k;...> -DOUT=<file.cpp>
#
# Writes the C++ file that defines `ops_jit_artifact_<k>` for every kernel (ops_jit_artifact.h of OPS).

# The bytes of a file as a C initialiser; the optional terminating NUL makes text usable as a C string.
function(_ops_jit_bytes file nul out_var)
  if(EXISTS "${file}")
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  else()
    set(hex "")
  endif()
  if(nul)
    string(APPEND hex "0x00")
  elseif(NOT hex)
    set(hex "0x00")   # no zero-length arrays
  endif()
  set(${out_var} "${hex}" PARENT_SCOPE)
endfunction()

set(content "// Generated by ops_add_jit_artifacts: do not edit.\n#include \"ops_jit_artifact.h\"\n\n")

foreach(k ${KERNELS})
  set(man "${DIR}/${k}.json")
  set(bin "${DIR}/${k}.mlirbc")
  file(READ "${man}" manifest)
  string(JSON status GET "${manifest}" status)
  string(JSON digest ERROR_VARIABLE derr GET "${manifest}" digest)
  if(derr)
    set(digest "")
  endif()

  set(code 1)
  set(size 0)
  set(bytes_ref "nullptr")
  if(status STREQUAL "ok" AND EXISTS "${bin}")
    set(code 0)
    file(SIZE "${bin}" size)
    _ops_jit_bytes("${bin}" FALSE bytes)
    string(APPEND content "static const unsigned char ops_jit_bytes_${k}[] = {${bytes}};\n")
    set(bytes_ref "ops_jit_bytes_${k}")
  endif()
  _ops_jit_bytes("${man}" TRUE mbytes)
  string(APPEND content "static const char ops_jit_manifest_${k}[] = {${mbytes}};\n")
  string(APPEND content
    "extern const ops_jit_artifact ops_jit_artifact_${k} = {OPS_JIT_ARTIFACT_VERSION, ${code}, \"${k}\", ${bytes_ref}, ${size}, ops_jit_manifest_${k}, \"${digest}\"};\n\n")
endforeach()

# Only touch the file when the content changes, so that unchanged artifacts do not recompile the application.
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()

# ctest driver: an application run with OPS_JIT_VERIFY=1 (every group compared with OPS's code) and OPS_JIT_STATS=1.
# It passes if the run succeeds, no group differs, and at least CLAIM_MIN percent of the loops were claimed.
#
#   cmake -DCMD="<command line>" -DWORKDIR=<run directory> [-DCLAIM_MIN=95] -P VerifyTest.cmake
set(ENV{OPS_JIT_VERIFY} "1")
set(ENV{OPS_JIT_STATS} "1")
if(NOT DEFINED CLAIM_MIN)
  set(CLAIM_MIN 95)
endif()
separate_arguments(cmds NATIVE_COMMAND "${CMD}")
execute_process(COMMAND ${cmds} WORKING_DIRECTORY "${WORKDIR}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "the run failed (${rc}):\n${out}\n${err}")
endif()
if(err MATCHES "ops_jit verify: \\[")
  message(FATAL_ERROR "groups differ from OPS:\n${err}")
endif()
if(NOT err MATCHES "ops_jit counters:[^\n]* loops=([0-9]+) claimed=([0-9]+)[^\n]* verify_groups=([0-9]+) verify_mismatches=([0-9]+)")
  message(FATAL_ERROR "no JIT counters printed (is the executable linked with libopsjit?):\n${err}")
endif()
set(loops ${CMAKE_MATCH_1})
set(claimed ${CMAKE_MATCH_2})
set(groups ${CMAKE_MATCH_3})
set(mismatches ${CMAKE_MATCH_4})
message(STATUS "${loops} loops, ${claimed} claimed, ${groups} groups checked, ${mismatches} with differences")
if(NOT mismatches EQUAL 0)
  message(FATAL_ERROR "${mismatches} groups differ from OPS")
endif()
if(groups EQUAL 0)
  message(FATAL_ERROR "no group was checked")
endif()
math(EXPR claimed_percent "${claimed} * 100 / ${loops}")
if(claimed_percent LESS CLAIM_MIN)
  message(FATAL_ERROR "only ${claimed_percent}% of the loops were claimed (at least ${CLAIM_MIN}% expected):\n${err}")
endif()
